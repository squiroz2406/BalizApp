# Clave de MapTiler (plan gratuito). Equivale a MAPTILER_KEY de local.properties en la app Kotlin.
EXPO_PUBLIC_MAPTILER_KEY=

# Gemini (Firebase AI Logic) desde JavaScript. Registrá una app Web en la consola de Firebase
# (Configuración del proyecto -> Tus apps -> Web) y copiá estos dos valores.
# La clave de la app Android del google-services.json NO sirve acá: está restringida a Android.
EXPO_PUBLIC_FIREBASE_WEB_API_KEY=
EXPO_PUBLIC_FIREBASE_WEB_APP_ID=
